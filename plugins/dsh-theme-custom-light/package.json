{
  "name": "dsh-theme-custom-light",
  "version": "0.1.0",
  "description": "Optional Custom Light appearance beside the native DSH Light, Dark and System themes.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/theme-service.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.2"
  }
}
