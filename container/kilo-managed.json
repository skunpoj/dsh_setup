{
  "model": "dsh-internal/deepseek-v4.1-flash",
  "small_model": "dsh-internal/deepseek-v4.1-flash",
  "enabled_providers": ["dsh-internal"],
  "share": "disabled",
  "autoupdate": false,
  "plugin": [],
  "mcp": {},
  "lsp": false,
  "formatter": false,
  "permission": {"*": "ask", "read": "allow", "glob": "allow", "grep": "allow", "webfetch": "deny", "websearch": "deny", "external_directory": "deny"},
  "experimental": {"openTelemetry": false},
  "provider": {
    "dsh-internal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DSH internal LiteLLM",
      "options": {
        "baseURL": "http://litellm.llm.svc.cluster.local:4000/v1",
        "apiKey": "{file:/harness-credentials/api-key}",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek-V4.1-Flash-1017 (internal)",
          "tool_call": true,
          "reasoning": false,
          "limit": {"context": 1048576, "output": 8192},
          "options": {"temperature": 0, "chat_template_kwargs": {"enable_thinking": false}}
        }
      }
    }
  }
}
