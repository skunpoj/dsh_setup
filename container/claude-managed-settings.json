{
  "model": "deepseek-v4.1-flash",
  "availableModels": [
    "deepseek-v4.1-flash"
  ],
  "availableModelsMatch": "exact",
  "enforceAvailableModels": true,
  "allowedProviders": [
    "customEndpoint"
  ],
  "requiredMinimumVersion": "2.1.301",
  "apiKeyHelper": "/opt/dsh/container/harness-api-key.sh",
  "permissions": {
    "disableAutoMode": "disable",
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /opt/dsh/container/dsh-banking-gate.cjs",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/node /opt/dsh/container/dsh-banking-gate.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "autoUpdatesChannel": "stable",
  "env": {
    "ANTHROPIC_BASE_URL": "http://litellm-gateway.llm.svc.cluster.local:4000",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4.1-flash",
    "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-v4.1-flash",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "deepseek-v4.1-flash",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Managed internal DeepSeek",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "MAX_THINKING_TOKENS": "0",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "API_TIMEOUT_MS": "3600000"
  }
}
