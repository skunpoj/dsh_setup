diff --git a/gpu-stack/tests/test_long_context_guard.py b/gpu-stack/tests/test_long_context_guard.py
index b103393..b8749a2 100644
--- a/gpu-stack/tests/test_long_context_guard.py
+++ b/gpu-stack/tests/test_long_context_guard.py
@@ -173,0 +174,25 @@ class LongContextGuardTests(unittest.IsolatedAsyncioTestCase):
+    def test_legacy_warm_encoder_preserves_original_wire_bytes(self):
+        payload = {'input_ids':[0, 123, 123456], 'rid':'owned-test',
+                   'sampling_params':{'max_new_tokens':1, 'temperature':0}}
+        self.scope['WARM_JSON_ENCODER'] = 'stdlib'
+        self.assertEqual(self.scope['encode_warm_payload'](payload), json.dumps(payload).encode())
+
+    def test_compact_encoder_preserves_decoded_payload(self):
+        payload = {'input_ids':[0, 123, 123456]*100, 'rid':'owned-test',
+                   'sampling_params':{'max_new_tokens':1, 'temperature':0}}
+        compact = lambda value: json.dumps(value, separators=(',', ':')).encode()
+        self.scope['_warm_fast_json'] = types.SimpleNamespace(dumps=compact)
+        self.scope['WARM_JSON_ENCODER'] = 'orjson'
+        encoded = self.scope['encode_warm_payload'](payload)
+        self.assertEqual(json.loads(encoded), payload)
+        self.assertLess(len(encoded), len(json.dumps(payload).encode()))
+
+    def test_selected_encoder_fails_closed_if_missing_or_invalid(self):
+        self.scope['_warm_fast_json'] = None
+        with patch.dict(os.environ, {'DSH_WARM_JSON_ENCODER':'orjson'}):
+            with self.assertRaises(RuntimeError): self.scope['configured_warm_encoder']()
+        with patch.dict(os.environ, {'DSH_WARM_JSON_ENCODER':'invalid'}):
+            with self.assertRaises(ValueError): self.scope['configured_warm_encoder']()
+        with patch.dict(os.environ, {}, clear=True):
+            self.assertEqual(self.scope['configured_warm_encoder'](), 'stdlib')
+
