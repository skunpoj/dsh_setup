+++ b/gpu-stack/runtime/long_context_callbacks.py
@@ -15,0 +16,5 @@ import uuid
+try:
+    import orjson as _warm_fast_json
+except ImportError:
+    _warm_fast_json = None
+
@@ -81,0 +87,20 @@ def count_request(data, final_envelope=False):
+def configured_warm_encoder():
+    name = os.environ.get('DSH_WARM_JSON_ENCODER', 'stdlib')
+    if name not in {'stdlib', 'orjson'}:
+        raise ValueError('DSH_WARM_JSON_ENCODER must be stdlib or orjson')
+    if name == 'orjson' and _warm_fast_json is None:
+        raise RuntimeError('The selected warm encoder is unavailable in this image')
+    return name
+
+
+WARM_JSON_ENCODER = configured_warm_encoder()
+
+
+def encode_warm_payload(payload):
+    # This payload contains only validated integer token IDs, an ASCII request
+    # id and fixed sampling fields. Final chat conditioning is not rewritten.
+    if WARM_JSON_ENCODER == 'orjson':
+        return _warm_fast_json.dumps(payload)
+    return json.dumps(payload).encode()
+
+
